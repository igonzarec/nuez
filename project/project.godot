; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Lantern Trail"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="LanternTrail"
config/features=PackedStringArray("4.6", "GL Compatibility")

[audio]

buses/default_bus_layout="uid://beko10tig1mrv"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
PauseMenu="*res://scripts/core/pause_menu.gd"
TrailWardrobe="*res://scripts/core/wardrobe.gd"

[dialogue_manager]

runtime/balloon_path="res://ui/dialogue/squirrel_dialogue_balloon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Explorer Squirrel- Lantern Trail"

[editor_plugins]

enabled=PackedStringArray("res://addons/click_place/plugin.cfg", "res://addons/cliff_tools/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/surface_painter/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/paso_de_bruma.dialogue")

[physics]

common/physics_interpolation=true

[rendering]

environment/defaults/default_clear_color=Color(0.18, 0.29, 0.45, 1)
